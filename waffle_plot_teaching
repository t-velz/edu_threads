# CONCEPT: a check() helper.
# R has no built-in pass/fail printer for little exercises, so we
# make one. Give it a label and a TRUE/FALSE test. It prints PASS
# or FAIL. The tasks at the end use this for instant feedback.
check <- function(label, passed) {
  if (isTRUE(passed)) {
    cat("PASS: ", label, "\n", sep = "")
  } else {
    cat("FAIL: ", label, "\n", sep = "")
  }
  invisible(isTRUE(passed))
}

